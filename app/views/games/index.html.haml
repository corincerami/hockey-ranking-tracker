%h1.text-center
    %span= @date.strftime('%B %-d, %Y')
    %span Games

.text-center
    - if @date > 1.day.ago
        =link_to (@date - 1.day).strftime('%B %-d'), root_path(date: (@date - 1.day)), style: 'margin: 5px;'
    - if @date < 1.week.from_now
        = link_to (@date + 1.day).strftime('%B %-d'), root_path(date: (@date + 1.day)), style: 'margin: 5px;'

.text-center.flex.games-index
    - @games.each do |game|
        = link_to game do
            %div.game-card
                %div
                    %div
                        %span
                            = image_tag "#{game.away_team.code}.svg", alt: "#{game.away_team.name} Logo", height: '100', width: '100', class: 'align-middle'
                        %span @
                        %span
                            = image_tag "#{game.home_team.code}.svg", alt: "#{game.home_team.name} Logo", height: '100', width: '100', class: 'align-middle'
                    %div
                        %span= game.date.to_time.strftime('%-I:%M %p PT')
                        %span /
                        %span= game.date.to_time.in_time_zone("Eastern Time (US & Canada)").strftime('%-I:%M %p ET')

