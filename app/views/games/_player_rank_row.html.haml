- last ||= false
- border_classes ||= ''
%td.player-rank-row{class: border_classes}
    - if finder.current_rank.value.zero?
        %span= "Waiting for his first #{finder.category.capitalize.singularize}"
    - else
        %span= "#{finder.category.capitalize}: #{finder.current_rank.value} (#{finder.current_rank.rank.ordinalize})"
        %span= "#{finder.to_next_rank} from #{finder.next_ranks.first.rank.ordinalize}"
        %span
            %button{popovertarget: "other-players-#{finder.player.id}", class: 'popover-button'}
                = image_tag "info.png", width: 20, class: 'icon'
- other_players = finder.next_ranks.map(&:player).map(&:name).join(', ')
%p{id: "other-players-#{finder.player.id}", class: 'popover', popover: 'hint'}= "#{finder.next_ranks.first.rank.ordinalize} currently held by #{other_players}"